+                context.coroutineScope.launch {
+                    delay(100)
+
+                    val messageId = try {
+                        context.database.getMessagesFromConversationId(conversationId, 1)?.firstOrNull()?.clientMessageId?.toLong()
+                    } catch (e: Exception) {
+                        context.log.warn("Failed to query database for latest message: ${e.message}")
+                        null
+                    }
+
+                    if (messageId == null) {
+                        return@launch
+                    }
