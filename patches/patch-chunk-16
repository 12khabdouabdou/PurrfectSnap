+                                    val minutes = remainingTime / 60
+                                    val seconds = remainingTime % 60
+                                    if (seconds == 0) "${minutes}m" else "${minutes}m ${seconds}s"
+                                }
+                                else -> "${remainingTime}s"
+                            }
