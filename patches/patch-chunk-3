+        document.title = conversationTitle
+    }
+
+    function decodeMedia(element) {
+        try {
+            const decodedData = new Uint8Array(
+                inflate(
+                    base64decode(
+                        element.innerHTML.substring(5, element.innerHTML.length - 4)
